{
  "name": "covey-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The covey React Native client (issue #168). Its own toolchain, outside the repository's pnpm workspace.",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "export": "node scripts/export.mjs",
    "prebuild": "expo prebuild --platform android",
    "codesign": "node scripts/codesign.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "57.0.19",
    "expo-image-picker": "57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-video": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.0"
  }
