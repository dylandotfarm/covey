#!/bin/sh
# The `covey` launcher. `scripts/setup.mjs` links this file into a directory on
# your PATH, so the command starts the client from this checkout. Keep it small:
# every start goes through it.
set -e

# Follow the symlinks back to the checkout that holds this file.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
entry=$root/packages/cli/dist/index.js

# The Node version test comes first: `node:sqlite` is a Node 22 builtin, so an
# older Node stops while it loads the modules, and a build on an older Node is
# no use anyway. `packages/cli/dist/index.js` makes the same test, for a start
# that does not come through this file.
min_major=22
if ! command -v node >/dev/null 2>&1; then
  echo "covey needs Node $min_major or newer; there is no \`node\` on the PATH." >&2
  exit 1
fi
node_version=$(node -v)            # for example: v24.21.0
node_major=${node_version#v}
node_major=${node_major%%.*}
case $node_major in
  '' | *[!0-9]*) node_major=0 ;;   # an unreadable version counts as too old
esac
if [ "$node_major" -lt "$min_major" ]; then
  echo "covey needs Node $min_major or newer; this is $node_version." >&2
  exit 1
fi

# A fresh clone, or a clone whose dist/ was removed, builds itself once.
# --force because tsc keeps a tsconfig.tsbuildinfo beside each package: without
# it, a build that has lost its dist/ is reported as up to date and emits nothing.
if [ ! -f "$entry" ]; then
  echo "covey: no build in $root — building it once" >&2
  (cd "$root" && pnpm install --frozen-lockfile && pnpm run build --force) >&2
fi

# Node runs as a child of this shell, not in place of it. V8's out-of-memory
# path calls abort(), and a SIGKILL or a segfault is the same: no JavaScript
# runs, so the client's own handlers never fire and the terminal keeps mouse
# reporting on and the alternate screen up. This shell is the only part that
# survives every death, so it puts the terminal back. See issue #58.
#
# Each trap has an action, and that action is what keeps this shell here for
# the client. A ctrl+c at the terminal goes to every process in the foreground
# group, so this shell gets one too, and a shell does not run a trap while a
# foreground command runs — so the client always exits first. An action also
# keeps the signal for the client: a shell resets a trapped signal to the
# default action in the child, but keeps an ignored signal ignored, so
# `trap '' INT` would take ctrl+c away from the client.
trap ':' INT TERM HUP QUIT
status=0
node "$entry" "$@" || status=$?

# Turn off the modes the client turns on: mouse reporting (1002 and 1006, from
# `disableMouse` in packages/tui/src/mouse.ts) and the alternate screen (1049,
# from packages/tui/src/index.tsx). `packages/cli/test/restore.test.ts` reads
# the modes out of those two files and out of this line, and fails when the
# two lists differ. Only to a terminal: in a pipe the bytes are noise.
if [ -t 1 ]; then printf '\033[?1002l\033[?1006l\033[?1049l' 2>/dev/null || :; fi

# Pass the death on: an exit status as it is, a signal by dying of the same
# signal, so `covey` in a script or in an `&&` chain sees what node saw.
if [ "$status" -gt 128 ]; then
  trap - INT TERM HUP QUIT
  kill -$((status - 128)) $$ 2>/dev/null || :
fi
exit "$status"
